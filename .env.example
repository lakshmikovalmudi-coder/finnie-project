# Copy to .env and fill in. NEVER commit .env.

# --- LLM (provided by the program) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Market data: https://www.alphavantage.co/support/#api-key ---
# Free tier: 25 req/day, 5 req/min — sign up in week 1 (keys can take ~24h)
ALPHA_VANTAGE_API_KEY=

# --- News search: pick ONE provider ---
NEWS_PROVIDER=tavily            # tavily | serpapi
TAVILY_API_KEY=                 # free: 1,000/mo  https://tavily.com
SERPAPI_API_KEY=                # free: 100/mo    https://serpapi.com

# --- Caching / fallbacks ---
CACHE_TTL_SECONDS=1800          # 30-min TTL per course notes
USE_MOCK_DATA=false             # true = never call external APIs (offline demo)

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MIN_SCORE=0.45            # below this a match counts as off-topic

# --- Router ---
ROUTER_MIN_CONFIDENCE=0.5
